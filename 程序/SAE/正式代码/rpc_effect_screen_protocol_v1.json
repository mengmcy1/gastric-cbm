    "p_values": false,
    "bh_fdr": false,
    "pass_fail": false,
    "combined_weighted_score": false
  },
  "rpc2_selection_frozen_before_rpc1_results": {
    "overall_high_effect": "top_5_percent_exactly_58_by_median_seed_mean_patient_abs_delta_margin_desc_then_anchor_id",
    "class_separation": "top_5_percent_exactly_58_by_median_seed_delta_D_desc_then_anchor_id",
    "source_risk_high_effect": "top_25_percent_exactly_ceil_n_times_0.25_within_source_risk_by_overall_effect_desc_then_anchor_id",
    "source_sensitivity_sentinels": "all_v1_vs_label_source_changed",
    "cancer_enriched_sentinel": "all_cancer_enriched_v1",
    "low_effect_controls": "bottom_20_overall_effect_ascending_then_anchor_id_not_rpc2_candidates_unless_selected_by_another_track",
    "rpc2_selected": "union_of_first_five_candidate_tracks",

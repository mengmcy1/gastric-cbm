{
  "protocol_name": "rpc1_residual_preserving_anchor_effect_screen_v1",
  "status": "frozen_before_effect_results_2026-08-25",
  "scope": "development_train_only_exploratory_effect_screen_of_1150_rpb_anchors",
  "inputs": {
    "anchor_count": 1150,
    "seeds": [42, 43, 44],
    "representation_k": 1024,
    "rpb_sharedness": "frozen_v1_label_stratified_bootstrap",
    "source_sensitivity": "diagnostic_only_label_x_source",
    "medical_semantics_used": false
  },
  "data_boundary": {
    "train_only": true,
    "val_evaluated": false,
    "internal_test_evaluated": false,
    "external_evaluated": false
  },
  "intervention": {
    "alpha": 0.0,
    "formula": "x_prime=x+(alpha-1)*h_j*d_j",
    "all_49_positions": true,
    "active_epsilon": 1e-8,
    "attention": "recomputed_from_intervened_patch_features",
    "pooling": "recomputed_attention_weighted_pooling",

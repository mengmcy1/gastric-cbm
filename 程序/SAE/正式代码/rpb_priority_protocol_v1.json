{
  "protocol_name": "rpb_priority_protocol_v1",
  "status": "frozen_after_numeric_audit_before_images_2026-08-25",
  "scope": "deterministic technical review tracks; no combined score and no medical semantics",
  "input_stage": "RP-B1/RP-B2 completed numeric tables",
  "images_viewed": false,
  "medical_labels_viewed": false,
  "combined_weighted_score_forbidden": true,
  "extremely_rare_overall_coverage_below": 0.10,
  "review_tracks_in_order": [
    "content_candidate",
    "source_risk",
    "rare",
    "technical_family_member"
  ],
  "track_assignment_first_match": [
    "not_family_representative -> technical_family_member",
    "extremely_rare -> rare",
    "source_risk -> source_risk",
    "otherwise -> content_candidate"
  ],
  "within_track_lexicographic_order": [
    "cross_seed_worst_edge_score_desc",
    "overall_patient_coverage_desc",
    "representation_energy_percentile_desc",
    "anchor_id_ascending"
  ],
  "separate_axis_ranks": [
    "stability_rank",
    "coverage_rank",
    "energy_rank",
    "label_auc_distance_rank"
  ],
  "track_is_confidence_grade": false,
  "track_is_medical_priority": false
}

{
  "protocol_name": "rpb_technical_protocol_v1",
  "status": "frozen_2026-08-25",
  "scope": "train-only exploratory technical analysis of 1150 RP-A-lite development strict anchors",
  "candidate_pool": {
    "source": "RP_A_Development_20260824/full_train_matching/formal/development_anchors.csv",
    "expected_anchor_count": 1150,
    "seeds": [42, 43, 44],
    "representation_k": 1024,
    "medical_naming_required": false
  },
  "data_boundary": {
    "train_only": true,
    "val_evaluated": false,
    "internal_test_evaluated": false,
    "external_evaluated": false,
    "images_viewed_for_threshold_selection": false
  },
  "sharedness": {
    "classes": [
      "cancer_enriched",
      "noncancer_enriched",
      "shared_high",
      "shared_low_rare",
      "mixed_uncertain"
    ],
    "bootstrap_replicates": 1000,
    "rng": "PCG64(20260825)",
    "patient_resampling": "stratified_by_label_with_replacement",
    "ci": 0.95,
    "quantile_method": "linear",
    "coverage_equivalence_margin_absolute": 0.10,
    "mass_contrast": "(mean_cancer-mean_noncancer)/(mean_cancer+mean_noncancer)",
    "mass_equivalence_margin_absolute": 0.10,
    "shared_high_minimum_coverage_each_label": 0.25,
    "seed_consensus_minimum": 2,
    "opposite_direction_seed_allowed": false,
    "label_auc_ci": "DeLong_95_percent",
    "ranking_absolute_amplitude_interpretation": false
  },
  "source_audit": {
    "stratify_by_label": true,
    "presence_test": "chi_square_2_by_source",
    "mass_test": "kruskal_wallis",
    "bh_fdr_q": 0.05,
    "presence_practical_range": 0.20,
    "mass_effect": "epsilon_squared",
    "mass_practical_effect": 0.05,
    "source_risk_seed_consensus_minimum": 2,
    "source_risk_role": "flag_only_not_exclusion"
  },
  "technical_family": {
    "medical_semantics_used": false,
    "within_seed_metrics": [
      "signed_decoder_cosine",
      "patient_union_positive_spearman",
      "top25_patient_jaccard",
      "patient_balanced_spatial_similarity"
    ],
    "thresholds": {
      "signed_decoder_cosine": 0.90,
      "patient_union_positive_spearman": 0.85,
      "top25_patient_jaccard": 0.40,
      "patient_balanced_spatial_similarity": 0.75
    },
    "seed_consensus_minimum": 2,
    "spatial_minimum_evaluable_patients": 25,
    "grouping": "deterministic_complete_link_greedy",
    "grouping_order": "anchor_id_ascending",
    "merge_tie_break": "lexicographically_smallest_cluster_id_pair",
    "singleton_retained": true
  },
  "representative_selection": {
    "scope": "within_each_technical_family",
    "lexicographic_order": [
      "cross_seed_worst_edge_score_desc",
      "overall_patient_coverage_desc",
      "representation_energy_percentile_desc",
      "anchor_id_ascending"
    ],
    "source_risk_changes_representative": false,
    "combined_weighted_score_forbidden": true
  },
  "lightweight_intervention": {
    "included_in_rpb": false,
    "next_stage": "RP-C",
    "all_anchor_first_probe": "100_to_0_percent_residual_preserving"
  }
}

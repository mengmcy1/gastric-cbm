{
  "schema_version": "stage1.9-source-feature-small-candidate-v1",
  "status": "frozen_before_run",
  "purpose": "Short-circuit 8-train-scene/2-validation-scene generalization gate before the 40/10 candidate.",
  "selection": {
    "train_scenes": [
      "ai_024_010", "ai_004_001", "ai_002_009", "ai_009_001",
      "ai_011_005", "ai_023_009", "ai_032_003", "ai_002_004"
